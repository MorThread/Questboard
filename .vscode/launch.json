{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Questboard: Run in Edge",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run dev",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithEdge",
        "webRoot": "${workspaceFolder}"
      }
    },
    {
      "name": "Questboard: Run in Chrome",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run dev",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}"
      }
    }
  ]
}
